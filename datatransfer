        function classifyQuery(q, source, practiceArea, user) {
            const t = (q || '').toLowerCase(), s = (source || '').toLowerCase(), u = (user || '').toLowerCase();
            
            // Override logic specifically for Dan Baker
            if (u === 'dan.baker@procore.com') {
                if (t.includes('email') || t.includes('communicate') || t.includes('message') || t.includes('draft') || t.includes('write') || t.includes('summary') || t.includes('summarize')) {
                    return "Strategic Correspondence & Comm Management";
                }
                return "System Administration & Legal AI Engineering";
            }

            // Check if query is explicitly asking for a summary
            const isSummarization = t.includes('summar') || t.includes('synthesiz') || t.includes('tl;dr') || t.includes('overview');
            
            // EXPLICIT SOURCE COLUMN CHECK: Route Lexis, Protege, and "[Country] Legal" to Research
            // OVERRIDE: Do not force Research if the user is explicitly asking to summarize
            if (!isSummarization && (s.includes('lexis') || s.includes('protege') || s.includes('protégé') || s.endsWith(' legal'))) {
                return "Legal Research & Analysis";
            }

            // QUESTION CHECK: Route open-ended questions without external/uploaded context to Research
            const isQuestion = t.includes('?') || /^(what|how|why|where|when|who)\b/.test(t.trim());
            const isWebFileVault = s.includes('web') || s.includes('file') || s.includes('vault');
            
            if (!isSummarization && isQuestion && !isWebFileVault) {
                return "Legal Research & Analysis";
            }

            if (practiceArea === "Litigation & Dispute Management") return "Litigation, Disputes & Corporate Integrity";
            if (practiceArea === "Employment, Litigation, & Compliance") return "Employment & Labor Law";
            
            if (s.includes('guide')) {
                const guideCat = CATEGORIES.find(c => c.id === 'harvey_guide');
                return guideCat ? guideCat.name : "Policy & Playbook Exploration (Harvey Guide)";
            }
            for (let c of CATEGORIES) { 
                if (c.id === 'harvey_guide') continue;
                for (let k of c.keywords) {
                    const regex = new RegExp('\\b' + k.trim().replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '\\b', 'i');
                    if (regex.test(t)) return c.name;
                }
            }
            return "Strategic Correspondence & Comm Management";
        }

