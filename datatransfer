                const matchesUser = uFilt.includes('all') || uFilt.length === 0 || uFilt.includes(r.user);
                const matchesPA = paFilt === 'all' || r.practiceArea === paFilt;
                const matchesTask = tFilt === 'all' || r.task === tFilt;
                
                const uc = classifyQuery(r.initialQuery, r.source, r.practiceArea, r.user);
                const sg = classifySubgroup(r.initialQuery, uc);
                const matchesUC = ucFilt === 'all' || uc === ucFilt;
                const matchesSG = sgFilt === 'all' || sg === sgFilt;
                
                const matchesSource = sFilt === 'all' || r.source === sFilt;
                
                let matchesSeq = true;
                if (seqFilt !== 'all') matchesSeq = seqFilt === '4+' ? r.steps >= 4 : r.steps === parseInt(seqFilt);

                let matchesTimeSaved = true;
                if (timeSavedFilt !== 'all') {
                    if (timeSavedFilt === 'high') matchesTimeSaved = r.timeSaved > 180;
                    else if (timeSavedFilt === 'medium') matchesTimeSaved = r.timeSaved >= 60 && r.timeSaved <= 180;
                    if (timeSavedFilt === 'low') matchesTimeSaved = r.timeSaved < 60;
                }

                return matchesSearch && matchesUser && matchesPA && matchesTask && matchesUC && matchesSG && matchesSource && matchesSeq && matchesTimeSaved;
            });
        }

