        function updateUserDeepDive() {
            const userEmail = document.getElementById('userDeepDiveFilter').value;
            const content = document.getElementById('userDeepDiveContent');
            const empty = document.getElementById('userDeepDiveEmpty');
            const narrativeContainer = document.getElementById('userNarrativeContent');

            if (!userEmail) {
                content.classList.add('hidden'); empty.classList.remove('hidden'); return;
            }

            content.classList.remove('hidden'); empty.classList.add('hidden');

            const userRecords = records.filter(r => r.user === userEmail);
            const totalROI = userRecords.reduce((s, r) => s + getROI(r.user, r.timeSaved, r), 0);
            const totalSteps = userRecords.reduce((s, r) => s + r.steps, 0);
            const threadCount = userRecords.length;
            const depth = (totalSteps / threadCount).toFixed(1);

            document.getElementById('userDeepDiveRoi').innerText = formatCurrency(totalROI);
            document.getElementById('userDeepDiveSteps').innerText = totalSteps.toLocaleString();
            document.getElementById('userDeepDiveDepth').innerText = depth;

            let internalVal = 0, externalVal = 0;
            const domains = {}, verbs = {};
            
            userRecords.forEach(r => {
                const baseVal = (r.timeSaved / 60) * getHourlyRate(r.user, r);
                internalVal += baseVal;
                if (isOutsideCounselDisplacement(r)) externalVal += (baseVal * (MULTIPLIER_OUTSIDE_COUNSEL - 1.0));
                const dom = classifyQuery(r.initialQuery, r.source, r.practiceArea, r.user);
                domains[dom] = (domains[dom] || 0) + 1;
                (r.initialQuery || '').toLowerCase().split(/[^a-zA-Z]/).forEach(w => {
                    if (STRATEGIC_VERBS.has(w)) verbs[w] = (verbs[w] || 0) + 1;
                });
            });

            const topDomain = Object.entries(domains).sort((a,b)=>b[1]-a[1])[0]?.[0] || "General Legal";
            const topVerb = Object.entries(verbs).sort((a,b)=>b[1]-a[1])[0]?.[0] || "analyze";
            const teamAvgDepth = records.reduce((s,r)=>s+r.steps,0) / records.length;
