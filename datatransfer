        function calculateStrategicScore(userRecords, domainFreqs, totalCount) {
            const AWARD_HIGH_STAKES_DOMAINS = [...HIGH_STAKES_DOMAINS, "Employment & Labor Law"];
            const breakdown = { items: { "Technical Depth": 0, "Iterative Ingenuity": 0, "Tooling Mastery": 0, "Strategic Intent": 0, "Domain Expertise": 0 } };
            const uniqueDomains = new Set();
            let highStakesVolume = 0;
            
            userRecords.forEach(r => {
                const domain = classifyQuery(r.initialQuery, r.source, r.practiceArea, r.user); uniqueDomains.add(domain);
                if (AWARD_HIGH_STAKES_DOMAINS.includes(domain)) {
                    breakdown.items["Technical Depth"] += 20;
                    highStakesVolume++;
                }
                if (r.steps >= 3) breakdown.items["Iterative Ingenuity"] += 25; else if (r.steps >= 2) breakdown.items["Iterative Ingenuity"] += 15;
                if ((r.source || '').toLowerCase().match(/workflow|vault/)) breakdown.items["Tooling Mastery"] += 35;
                if ((r.initialQuery || '').toLowerCase().split(/[^a-zA-Z]/).some(w => STRATEGIC_VERBS.has(w))) breakdown.items["Strategic Intent"] += 10;
            });
            
            breakdown.items["Domain Expertise"] = Math.max(uniqueDomains.size * 20, highStakesVolume * 20);
            
            if (uniqueDomains.has("Employment & Labor Law") && breakdown.items["Iterative Ingenuity"] > 0) {
                breakdown.items["Tooling Mastery"] += 25;
            }

            Object.keys(breakdown.items).forEach(k => breakdown.items[k] = Math.min(breakdown.items[k], 100));
            return { total: Math.round(Object.values(breakdown.items).reduce((a,b) => a+b, 0) / 5), breakdown };
        }

