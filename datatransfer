        }

        function calculateTrendline(x, y) {
            const validIndices = x.map((_, i) => i).filter(i => y[i] !== null && y[i] !== undefined);
            const n = validIndices.length; 
            if (n === 0) return [];
            let sX = 0, sY = 0, sXY = 0, sXX = 0;
            for (let i = 0; i < n; i++) { 
                let idx = validIndices[i];
                sX += x[idx]; 
                sY += y[idx]; 
                sXY += x[idx] * y[idx]; 
                sXX += x[idx] * x[idx]; 
            }
            const divisor = (n * sXX - sX * sX);
            if (divisor === 0) return x.map(() => y[validIndices[0]] || 0);
            const slope = (n * sXY - sX * sY) / divisor, intercept = (sY - slope * sX) / n;
            return x.map(val => slope * val + intercept);
        }

