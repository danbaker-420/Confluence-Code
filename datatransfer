            const dates = records.map(r => new Date(r.time)).filter(d => !isNaN(d.getTime()));
            const startDate = new Date(Math.min(...dates)).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: PREFERRED_TIMEZONE });
            const endDate = new Date(Math.max(...dates)).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: PREFERRED_TIMEZONE });
            document.getElementById('execDateRange').innerText = `Reporting Period: ${startDate} - ${endDate}`;

            // Aggregate Metrics
            let totalROI = 0, totalMins = 0, externalSavings = 0;
            const paMap = {}, ucMap = {};
            
            records.forEach(r => {
                totalMins += r.timeSaved;
                const roi = getROI(r.user, r.timeSaved, r);
                totalROI += roi;
                
                const baseValue = (r.timeSaved / 60) * getHourlyRate(r.user, r);
                if (isOutsideCounselDisplacement(r)) {
                    externalSavings += (baseValue * (MULTIPLIER_OUTSIDE_COUNSEL - 1.0));
                }

                // Practice Area
                if (!paMap[r.practiceArea]) paMap[r.practiceArea] = 0;
                paMap[r.practiceArea] += roi;

                // Use Case
                const uc = classifyQuery(r.initialQuery, r.source, r.practiceArea, r.user);
                if (!ucMap[uc]) ucMap[uc] = 0;
                ucMap[uc] += roi;
            });

            const uniqueUsers = new Set(records.map(r => r.user)).size;
            const totalThreads = records.length;

            // Hero Metrics
            const heroHtml = `
                <div class="p-5 bg-emerald-50 border border-emerald-100 rounded-xl">
                    <p class="text-[10px] font-black text-emerald-600 uppercase tracking-widest mb-1">Total ROI</p>
                    <h4 class="text-3xl font-black text-emerald-700">${formatCurrency(totalROI)}</h4>
                </div>
                <div class="p-5 bg-indigo-50 border border-indigo-100 rounded-xl">
                    <p class="text-[10px] font-black text-indigo-600 uppercase tracking-widest mb-1">Hours Reclaimed</p>
                    <h4 class="text-3xl font-black text-indigo-700">${formatHours(totalMins)}</h4>
                </div>
                <div class="p-5 bg-slate-50 border border-slate-200 rounded-xl">
                    <p class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1">Active Personnel</p>
                    <h4 class="text-3xl font-black text-slate-800">${uniqueUsers} <span class="text-sm text-slate-400 font-bold ml-1 uppercase">Members</span></h4>
                </div>
                <div class="p-5 bg-[#F57F26]/10 border border-[#F57F26]/20 rounded-xl">
                    <p class="text-[10px] font-black text-[#F57F26] uppercase tracking-widest mb-1">Query Volume</p>
                    <h4 class="text-3xl font-black text-[#e06d15]">${totalThreads.toLocaleString()} <span class="text-sm text-[#F57F26]/60 font-bold ml-1 uppercase">Threads</span></h4>
                </div>
            `;
            document.getElementById('execHeroMetrics').innerHTML = heroHtml;

            // Advanced Strategic Metrics
            const contractCost = 101922;
            const breakevenPct = totalROI > 0 ? ((totalROI / contractCost) * 100).toFixed(1) : 0;
            
            const wauAgg = records.reduce((acc, r) => {
                const w = getStartOfWeek(r.time);
                if (!w) return acc;
                if (!acc[w]) acc[w] = new Set();
                acc[w].add(r.user);
                return acc;
            }, {});
            const wauValues = Object.values(wauAgg).map(s => s.size);
            const avgWAU = wauValues.length ? (wauValues.reduce((a,b)=>a+b,0) / wauValues.length) : 0;
            const wauStickiness = uniqueUsers ? ((avgWAU / uniqueUsers) * 100).toFixed(1) : 0;

            const monthlyAgg = records.reduce((acc, r) => {
                const d = new Date(r.time);
                if (isNaN(d.getTime())) return acc;
                const sortKey = d.getFullYear() * 100 + d.getMonth();
                const label = d.toLocaleString('default', { month: 'long', year: 'numeric', timeZone: PREFERRED_TIMEZONE });
                if (!acc[sortKey]) acc[sortKey] = { sortKey, label, roi: 0, threads: 0, mins: 0 };
                acc[sortKey].roi += getROI(r.user, r.timeSaved, r);
                acc[sortKey].threads++;
                acc[sortKey].mins += r.timeSaved;
                return acc;
            }, {});
            const sortedMonths = Object.values(monthlyAgg).sort((a,b) => a.sortKey - b.sortKey);
            
            let cumulativeROI = 0;
            let breakevenMonth = null;
            for (const m of sortedMonths) {
                cumulativeROI += m.roi;
                if (cumulativeROI >= contractCost && !breakevenMonth) {
                    breakevenMonth = m.label;
                }
            }

            let breakevenText = "";
            if (breakevenMonth) {
                breakevenText = ` We successfully crossed the full contract breakeven threshold in <strong>${breakevenMonth}</strong>!`;
            } else {
                const avgMonthlyRoi = cumulativeROI / (sortedMonths.length || 1);
                const monthsLeft = avgMonthlyRoi > 0 ? Math.ceil((contractCost - cumulativeROI) / avgMonthlyRoi) : 'N/A';
                breakevenText = ` We are currently projected to cross the full breakeven point in approximately <strong>${monthsLeft} months</strong> based on current run rates.`;
            }
            
            // Filter out the current partial month for an accurate growth trajectory
            const currentMonthKeyFull = getCurrentMonthKey('long');
            const completedMonths = sortedMonths.filter(m => m.label !== currentMonthKeyFull);
            const growthData = completedMonths.length >= 2 ? completedMonths : sortedMonths;

            let roiGrowth = "0.0", activityGrowth = "0.0", effGrowth = "0.0";
            let roiGrowthVal = 0, activityGrowthVal = 0;

            if (growthData.length >= 2) {
                const first = growthData[0];
                const last = growthData[growthData.length - 1];
                
                roiGrowthVal = first.roi > 0 ? (((last.roi - first.roi) / first.roi) * 100) : 0;
                activityGrowthVal = first.threads > 0 ? (((last.threads - first.threads) / first.threads) * 100) : 0;
                
                roiGrowth = roiGrowthVal.toFixed(1);
                activityGrowth = activityGrowthVal.toFixed(1);
                
                const firstEff = first.threads > 0 ? first.mins / first.threads : 0;
                const lastEff = last.threads > 0 ? last.mins / last.threads : 0;
                effGrowth = firstEff > 0 ? (((lastEff - firstEff) / firstEff) * 100).toFixed(1) : "N/A";
            }
            
            const avgEff = totalThreads > 0 ? Math.round(totalMins / totalThreads) : 0;
            
            const multiStepCount = records.filter(r => r.steps >= 2).length;
            const deepStepCount = records.filter(r => r.steps >= 3).length;
            const strategicDensityCount = records.filter(r => HIGH_STAKES_DOMAINS.includes(classifyQuery(r.initialQuery, r.source, r.practiceArea, r.user))).length;

            const multiStepPct = totalThreads ? ((multiStepCount / totalThreads) * 100).toFixed(1) : 0;
            const deepStepPct = totalThreads ? ((deepStepCount / totalThreads) * 100).toFixed(1) : 0;
            const strategicPct = totalThreads ? ((strategicDensityCount / totalThreads) * 100).toFixed(1) : 0;

            const formatGrowth = (val) => val !== "N/A" && parseFloat(val) > 0 ? '+' + val : val;
            
            // Dynamic text based on positive or negative trajectory
            const roiDirection = roiGrowthVal >= 0 ? "expanding" : "contracting";
            const actDirection = activityGrowthVal >= 0 ? "increase" : "decrease";
            const momentumNarrative = roiGrowthVal >= 0 
                ? `This trajectory demonstrates that our financial returns are not just a byproduct of early experimentation, but are scaling consistently as the team's reliance on the platform deepens, translating higher adoption directly into sustained bottom-line impact.`
                : `This trajectory indicates a recent dip in overall platform utilization. While early usage may have driven initial spikes, this data suggests an opportunity to re-engage the team, refresh training, or identify workflow bottlenecks preventing sustained, habitual adoption.`;

            // Strategic Narrative
            document.getElementById('execNarrative').innerHTML = `
                <div class="space-y-6">
                    <p><strong>Harvey</strong> is a domain-specific generative AI platform built for legal professionals, designed to accelerate complex research, automate document analysis, streamline drafting, and enhance contract review. Over the current reporting period (${startDate} through ${endDate}), the platform has been a strong success, evolving into a highly valued and essential asset for the team surrounding daily legal workflows, complex matter scaffolding, and strategic cost avoidance. The following highlights our strategic trajectory across key performance indicators:</p>

                    <div class="space-y-5 mt-4">
                        <div>
                            <h4 class="text-[11px] font-black text-slate-800 uppercase tracking-widest border-b border-slate-100 pb-1 mb-2">1. Contract ROI & Breakeven</h4>
                            <p class="text-[13px] text-slate-700">The team is performing very well, already achieving an impressive <strong>${breakevenPct}%</strong> of the annualized contract cost.${breakevenText} Thanks to consistent utilization, the platform is delivering compounded economic returns through direct time savings and effective avoidance of external spend.</p>
                        </div>
                        
                        <div>
                            <h4 class="text-[11px] font-black text-slate-800 uppercase tracking-widest border-b border-slate-100 pb-1 mb-2">2. Financial & Activity Momentum</h4>
                            <p class="text-[13px] text-slate-700">Comparing the start of the reporting period to the most recent full month, Monthly ROI is ${roiDirection} with an overall growth trajectory of <strong>${formatGrowth(roiGrowth)}%</strong>. This aligns closely with a <strong>${formatGrowth(activityGrowth)}%</strong> ${actDirection} in query volume over the same timeframe. ${momentumNarrative}</p>
                        </div>

                        <div>
                            <h4 class="text-[11px] font-black text-slate-800 uppercase tracking-widest border-b border-slate-100 pb-1 mb-2">3. Efficiency & Engagement Stickiness</h4>
                            <p class="text-[13px] text-slate-700">Over this same timeframe, the team's operational efficiency is steadily shifting. The monthly efficiency ratio has changed by <strong>${formatGrowth(effGrowth)}%</strong>, now saving a strong average of <strong>${avgEff}m</strong> per interaction. Additionally, our weekly active usage (WAU) maintains a <strong>${wauStickiness}%</strong> stickiness rate against the active base, demonstrating consistent reliance on the platform.</p>
                        </div>

                        <div>
                            <h4 class="text-[11px] font-black text-slate-800 uppercase tracking-widest border-b border-slate-100 pb-1 mb-2">4. Usage Maturity & Strategic Complexity</h4>
                            <p class="text-[13px] text-slate-700">We are seeing advanced usage across the board. A notable <strong>${multiStepPct}%</strong> of sessions now feature sophisticated multi-step prompting, with <strong>${deepStepPct}%</strong> reaching deep engineering status (3+ steps). With <strong>${strategicPct}%</strong> of our total volume tackling crucial high-stakes domains, the team is actively leveraging AI for highly strategic outcomes.</p>
                        </div>
                    </div>

                    <div class="p-5 bg-slate-50 border-l-4 border-slate-800 rounded-r-lg mt-6 shadow-sm">
                        <p class="text-[11px] font-black text-slate-800 uppercase tracking-[0.15em] mb-2 flex items-center gap-2"><svg class="w-4 h-4 text-[#F57F26]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg> The Aggregate Story</p>
                        <p class="text-[13px] text-slate-700 font-medium leading-relaxed">This data tells a compelling story of continuous improvement and strategic value. Our department has successfully embraced AI, transforming it into a high-yielding operational tool. With strong engagement stickiness and a clear focus on advanced, high-stakes workflows, the platform is generating substantial economic value. Driven by growing volume and rising efficiency, the team is well on track to establish AI as an indispensable, permanent multiplier for our output and success.</p>
                    </div>
                </div>
            `;

            // Key Drivers
            const topPA = Object.entries(paMap).sort((a, b) => b[1] - a[1])[0] || ['Unknown', 0];
            const topUC = Object.entries(ucMap).sort((a, b) => b[1] - a[1])[0] || ['Unknown', 0];

            document.getElementById('execDrivers').innerHTML = `
                <div class="p-4 bg-white border border-slate-200 rounded-lg shadow-sm">
                    <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-1">Top Practice Area (By Impact)</p>
                    <h4 class="text-sm font-black text-slate-800">${topPA[0]}</h4>
                    <p class="text-xs text-emerald-600 font-bold mt-1">${formatCurrency(topPA[1])} Generated</p>
                </div>
                <div class="p-4 bg-white border border-slate-200 rounded-lg shadow-sm">
                    <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-1">Top Use Case (By Impact)</p>
                    <h4 class="text-sm font-black text-slate-800">${topUC[0]}</h4>
                    <p class="text-xs text-emerald-600 font-bold mt-1">${formatCurrency(topUC[1])} Generated</p>
                </div>
                <div class="p-4 bg-white border border-slate-200 rounded-lg shadow-sm">
                    <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-1">Ext Counsel Displacement</p>
                    <h4 class="text-sm font-black text-slate-800">${((externalSavings / totalROI) * 100).toFixed(1)}% of Total ROI</h4>
                    <p class="text-xs text-[#0076B6] font-bold mt-1">${formatCurrency(externalSavings)} Avoided</p>
                </div>
            `;
        }

        function handleSort(key) { if (sortKey === key) sortOrder = sortOrder === 'asc' ? 'desc' : 'asc'; else { sortKey = key; sortOrder = 'asc'; } renderTable(getFilteredData()); }
        function handleEngagementSort(key) { if (engSortKey === key) engSortOrder = engSortOrder === 'asc' ? 'desc' : 'asc'; else { engSortKey = key; engSortOrder = 'asc'; } renderEngagementBreakdown(getFilteredData()); }

        window.onload = async () => {
            switchTab('explorer');
            try {
                const localData = await loadRecordsLocally();
                if (localData && localData.length > 0) {
                    records = localData;
                    updateFilters(); 
                    renderTable(getFilteredData()); 
                    updateDateRangeDisplay();
                    document.getElementById('clearDataBtn').classList.remove('hidden');
                    showToast("Loaded previous session data.", "info");
                }
            } catch(e) {
                console.error("No local data found or accessible.", e);
            }
        };
    </script>
</body>
</html>
