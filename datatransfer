                const headers = parsedRows[0].map(h => h.toLowerCase().trim());
                
                const m = { time: headers.indexOf('utc time'), user: headers.indexOf('user'), task: headers.indexOf('subsurface'), query: headers.indexOf('query'), response: headers.indexOf('response'), source: headers.indexOf('source'), link: headers.findIndex(h => h.includes('link') || h === 'url') };
                
                let rawData = parsedRows.slice(1).map(row => {
                    const userEmail = row[m.user] || '', meta = USER_DIRECTORY[userEmail] || { pa: "Other", role: "Non-Attorney" };
                    let linkVal = m.link !== -1 ? row[m.link] : '';
                    if (linkVal) linkVal = linkVal.replace(/\/draft/gi, '');
                    return { time: row[m.time] || '', user: userEmail, task: row[m.task] || 'Assist', query: row[m.query] || '', response: row[m.response] || '', source: row[m.source] || '', link: linkVal, practiceArea: meta.pa, role: meta.role };
                });

                rawData.sort((a, b) => a.user !== b.user ? a.user.localeCompare(b.user) : new Date(a.time) - new Date(b.time));

